      ],
      "matchDepTypes": [
        "pre-commit"
      ],
      "groupName": "pre-commit dependencies",
      "groupSlug": "pre-commit-deps",
      "separateMajorMinor": false,
      "automerge": true
    }
  ],
  "pre-commit": {
    "enabled": true
  }
