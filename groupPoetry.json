{
  "packageRules": [
    {
      "groupName": "`poetry` <dev> dependencies (non-major)",
      "groupSlug": "poetry-dev-deps-nonmajor",
      "matchDepTypes": [
        "dev"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "`poetry` <docs> dependencies (non-major)",
      "groupSlug": "poetry-docs-deps-nonmajor",
      "matchDepTypes": [
        "docs"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    }
  ]
}
