{
  "packageRules": [
    {
      "groupName": "`uv` <dev> dependencies (non-major)",
      "groupSlug": "uv-dev-deps-nonmajor",
      "matchDepTypes": [
        "dev"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "`uv` <docs> dependencies (non-major)",
      "groupSlug": "uv-docs-deps-nonmajor",
      "matchDepTypes": [
        "docs"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "uv dependencies",
      "groupSlug": "uv-deps",
      "matchPackageNames": [
        "/.*uv.*/"
      ],
      "matchSourceUrls": [
        "/https://github.com/astral-sh/.*/"
      ],
      "automerge": true,
      "separateMajorMinor": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": [
        "^pyproject\\.toml$"
      ],
      "matchStrings": [
        "^requires\\s*=\\s*\\[.*?['\"](?<depName>uv_build)(?<currentValue>@?[^'\"]*)['\"].*?\\]"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
