{
  "packageRules": [
    {
      "groupName": "Ruff dependencies",
      "groupSlug": "ruff-deps",
      "matchPackageNames": [
        "/.*ruff.*/"
      ],
      "matchSourceUrls": [
        "/https://github.com/astral-sh/.*/"
      ],
      "rangeStrategy": "bump",
      "automerge": true,
      "separateMajorMinor": false
    }
  ]
}
