{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "schedule:earlyMondays",
    "local>aviation-impact-accelerator/renovate-config:groupRuff"
  ],
  "reviewers": [
    "aia-software"
  ],
  "timezone": "Europe/London",
  "updateLockFiles": true,
  "packageRules": [
    {
      "groupName": "`poetry` <dev> dependencies (non-major)",
      "groupSlug": "poetry-dev-deps-nonmajor",
      "matchDepTypes": [
        "dev"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "`poetry` <docs> dependencies (non-major)",
      "groupSlug": "poetry-docs-deps-nonmajor",
      "matchDepTypes": [
        "docs"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "groupName": "Terraform dependencies",
      "groupSlug": "terraform-deps",
      "matchManagers": [
        "terraform"
      ],
      "automerge": true
    },
    {
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "gha-deps",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "groupName": "pre-commit dependencies",
      "groupSlug": "pre-commit-deps",
      "matchManagers": [
        "pre-commit"
      ],
      "separateMajorMinor": false,
      "automerge": true
    },
    {
      "groupName": "git-submodules",
      "matchManagers": [
        "git-submodules"
      ],
      "automerge": true
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "git-submodules": {
    "enabled": true
  }
}
