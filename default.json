{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>aviation-impact-accelerator/renovate-config:copierTemplateUpdate",
    "local>aviation-impact-accelerator/renovate-config:groupGitHubActions",
    "local>aviation-impact-accelerator/renovate-config:groupGitSubmodules",
    "local>aviation-impact-accelerator/renovate-config:groupUv",
    "local>aviation-impact-accelerator/renovate-config:groupPreCommit",
    "local>aviation-impact-accelerator/renovate-config:groupTerraform",
    "local>aviation-impact-accelerator/renovate-config:groupRuff"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml\\.jinja$/",
      "/(^|/)action\\.ya?ml\\.jinja$/",
      "/(^|/)\\.github/workflows/\\{%-?\\s*if\\s+[^%]+\\s*-?%\\}[^/]+\\.ya?ml\\{%-?\\s*endif\\s*-?%\\}(?:\\.jinja)?$/"
    ]
  },
  "pep621": {
    "managerFilePatterns": [
      "/(^|/)pyproject\\.toml\\.jinja$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update GitHub Actions in conditional Copier workflow templates",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/\\{%-?\\s*if\\s+[^%]+\\s*-?%\\}[^/]+\\.ya?ml\\{%-?\\s*endif\\s*-?%\\}(?:\\.jinja)?$/"
      ],
      "matchStrings": [
        "uses:\\s*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)@(?<currentValue>v?\\d+(?:\\.\\d+){0,2})",
        "uses:\\s*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+)@(?<currentDigest>[a-f0-9]{40})\\s+#\\s*(?<currentValue>v?\\d+(?:\\.\\d+){0,2})"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "github-actions",
      "depTypeTemplate": "action"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions found in conditional Copier templates",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepTypes": [
        "action"
      ],
      "groupName": "GitHub Actions dependencies",
      "groupSlug": "gha-deps",
      "automerge": true
    }
  ],
  "schedule": [
    "at any time"
  ],
  "prHourlyLimit": 0,
  "labels": [
    "chore"
  ],
  "timezone": "Europe/London",
  "updateLockFiles": true
}
