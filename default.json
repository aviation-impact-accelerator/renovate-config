{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "local>aviation-impact-accelerator/renovate-config:copierTemplateUpdate",
    "local>aviation-impact-accelerator/renovate-config:groupGitHubActions",
    "local>aviation-impact-accelerator/renovate-config:groupGitSubmodules",
    "local>aviation-impact-accelerator/renovate-config:groupPreCommit",
    "local>aviation-impact-accelerator/renovate-config:groupTerraform",
    "local>aviation-impact-accelerator/renovate-config:groupUv",
    "local>aviation-impact-accelerator/renovate-config:groupRuff"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Python dependencies in Copier pyproject templates",
      "managerFilePatterns": [
        "/(^|/)pyproject\\.toml\\.jinja$/"
      ],
      "matchStrings": [
        "\\\"(?<depName>[A-Za-z0-9][A-Za-z0-9_.-]*)(?:\\[[^\\\"\\]]+\\])?(?<currentValue>(?:(?:~=|==|!=|<=|>=|<|>)\\s*[^\\\"\\s,]+)(?:\\s*,\\s*(?:~=|==|!=|<=|>=|<|>)\\s*[^\\\"\\s,]+)*)\\\""
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440",
      "depTypeTemplate": "python-template"
    },
    {
      "customType": "regex",
      "description": "Update pre-commit repositories in prek configs and Copier prek templates",
      "managerFilePatterns": [
        "/(^|/)prek\\.toml(\\.jinja)?$/"
      ],
      "matchStrings": [
        "repo\\s*=\\s*\\\"https://github\\.com/(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?)(?:\\.git)?\\\"\\s*rev\\s*=\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver-coerced",
      "depTypeTemplate": "pre-commit"
    },
    {
      "customType": "regex",
      "description": "Update GitHub Actions in Copier workflow templates",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml\\.jinja$/",
        "/(^|/)action\\.ya?ml\\.jinja$/",
        "/(^|/)\\.github/workflows/\\{%-?\\s*if\\s+[^%]+\\s*-?%\\}[^/]+\\.ya?ml\\{%-?\\s*endif\\s*-?%\\}(?:\\.jinja)?$/"
      ],
      "matchStrings": [
        "uses:\\s*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)(?:/[A-Za-z0-9_./-]+)?@(?<currentValue>v?\\d+(?:\\.\\d+){0,2})(?:\\s|$)",
        "uses:\\s*(?<depName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)(?:/[A-Za-z0-9_./-]+)?@(?<currentDigest>[a-f0-9]{40})\\s*#\\s*(?<currentValue>v?\\d+(?:\\.\\d+){0,2})"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "github-actions",
      "depTypeTemplate": "action"
    },
    {
      "customType": "regex",
      "description": "Update container images in Copier workflow templates",
      "managerFilePatterns": [
        "/(^|/)(workflow-templates|\\.(?:github|gitea|forgejo)/(?:workflows|actions))/.+\\.ya?ml\\.jinja$/",
        "/(^|/)action\\.ya?ml\\.jinja$/"
      ],
      "matchStrings": [
        "image:\\s*(?<depName>[A-Za-z0-9.-]+/[A-Za-z0-9_./-]+):(?<currentValue>[A-Za-z0-9._-]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "depTypeTemplate": "container-image"
    }
  ],
  "packageRules": [
    {
      "description": "Raise the floor of Python tooling and build dependencies to the new version, and refresh uv.lock",
      "matchDepTypes": [
        "build-system.requires",
        "dependency-groups",
        "python-template",
        "tool.uv.dev-dependencies"
      ],
      "rangeStrategy": "bump"
    },
    {
      "description": "Leave the floor of runtime dependencies alone so libraries don't narrow what downstream users can install. Only uv.lock is refreshed. Extend bumpRuntimeDeps to raise them",
      "matchDepTypes": [
        "project.dependencies",
        "project.optional-dependencies"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Only automerge non-major updates. Defined here so it applies after, and overrides, the presets in extends",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "0.x packages can break in a minor release, so treat a 0.x minor update like a major. Hook revs can have a v prefix",
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "A new Python minor version (e.g. 3.14 to 3.15) needs review. Patch versions still automerge",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "description": "These datasources (and Docker registries other than Docker Hub) have no release timestamps, which would hold their updates forever under minimumReleaseAge",
      "matchDatasources": [
        "docker",
        "git-refs",
        "git-tags"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Internal packages come from the private GitLab registry, which may not provide release timestamps",
      "matchPackageNames": [
        "camia-*",
        "pytest-camia"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Lock file maintenance has no single release to age, so it would be held forever. uv picks the versions itself",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "minimumReleaseAge": null
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 3 * * 1"
    ]
  },
  "automerge": true,
  "minimumReleaseAge": "3 days",
  "schedule": [
    "* 3 * * 1"
  ],
  "prHourlyLimit": 0,
  "labels": [
    "chore"
  ],
  "reviewers": [
    "team:aia-software"
  ],
  "timezone": "Europe/London"
}
